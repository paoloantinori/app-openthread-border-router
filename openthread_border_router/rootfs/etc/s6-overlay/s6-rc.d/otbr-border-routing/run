#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Re-asserts border_routing=false for the whole life of the container.
# ==============================================================================
#
# Several agent re-initialization paths re-enable border routing after boot
# (deleting the dataset over REST, the web UI pseudo reset, and otPlatReset,
# which re-execs otbr-agent in place): the startup oneshot runs only once, so
# without this watchdog the Router Advertisements on the infrastructure
# network would silently come back.

# shellcheck source=./openthread_border_router/rootfs/etc/s6-overlay/scripts/otbr-agent-common
. /etc/s6-overlay/scripts/otbr-agent-common

if bashio::config.true 'border_routing'; then
    # Nothing to enforce: park so the service stays up but idle.
    while true; do
        sleep 3600
    done
fi

while true; do
    if ot-ctl br state 2>/dev/null | grep -q running; then
        bashio::log.warning \
            "Border routing is running again (agent re-init): disabling it."
        otbr_disable_border_routing
    fi
    sleep 60
done
